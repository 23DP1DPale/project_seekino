{
  "$schema": "https://schema.railpack.com",
  "provider": "php",
  "packages": {
    "php": "8.3"
  },
  "buildAptPackages": [
    "autoconf",
    "bison",
    "build-essential",
    "curl",
    "git",
    "libcurl4-openssl-dev",
    "libonig-dev",
    "libreadline-dev",
    "libsqlite3-dev",
    "libssl-dev",
    "libxml2-dev",
    "libzip-dev",
    "pkg-config",
    "re2c",
    "unzip",
    "zlib1g-dev"
  ],
  "deploy": {
    "aptPackages": [
      "curl",
      "git",
      "unzip"
    ]
  }
}
